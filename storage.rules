rules_version = '2';

// NOTE: Storage rules were previously unmanaged in this repo (whatever is in the
// Firebase console applies). Adding this file + the "storage" block in
// firebase.json means the next `firebase deploy` REPLACES the console rules.
// The only path the app used before the feed is users/{uid}/avatar-*, covered below.

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isImageUnder(maxBytes) {
      return request.resource.contentType.matches('image/.*')
             && request.resource.size < maxBytes;
    }

    // Profile avatars — owner-only. Existing photoUrl values are tokenized
    // download URLs, which keep working regardless of these rules.
    match /users/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isImageUnder(8 * 1024 * 1024);
    }

    // Feed photos — the optional shot clipped to a poster. Readable by any
    // signed-in athlete because the feed is global; writable only by the owner.
    // The client downscales to ~1080px before upload, so the 4MB cap is a
    // backstop against someone bypassing the UI, not the expected size.
    match /feedPhotos/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isImageUnder(4 * 1024 * 1024);
      allow delete: if isOwner(uid);
    }
  }
}
