rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Mirrors ADMIN_EMAIL in the app — the triage owner for shared collections.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'aborovitz@gmail.com';
    }

    // Users can read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can read/write their own workouts
    match /workouts/{workoutId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Users can read/write their own personal records. Scoped to the owner like /workouts —
    // an unscoped `request.auth != null` let any signed-in athlete read or overwrite anyone's.
    match /personalRecords/{recordId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Users can read/write their own saved WODs
    match /savedWods/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Movement registry — the canonical family/implement table every client
    // reads at boot. Triage writes it from the console; clients never do.
    match /movementRegistry/{movementId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Movement flag queue — telemetry for movements the registry couldn't place.
    // Any signed-in client appends (merge write, keyed by normalized name);
    // only triage reads the ranked list back or clears it.
    match /movementFlags/{movementId} {
      allow create, update: if request.auth != null;
      allow read, delete: if isAdmin();
    }

    // ── Feed ────────────────────────────────────────────────────────────────
    // The feed is global and no-follow, which means /workouts can never be the
    // read source: that doc carries rawText (raw whiteboard OCR), corrections,
    // notes and EP, and it stays owner-scoped above. A feed post freezes just
    // the poster it renders. Nobody can edit anyone else's poster because
    // nobody can read the workout behind it.

    // An athlete's public identity, split out of /users for one reason: rules
    // are per-DOCUMENT, so "allow read" on /users would hand over email, sex,
    // bodyweight and stats along with the name. This doc holds only what the
    // feed shows, and it is an ALLOWLIST — a new field on /users stays private
    // until it is deliberately copied here.
    //
    // Owner-only write is also what makes impersonation impossible, and it
    // costs nothing: posts carry a uid rather than a copied name, so there is
    // no identity on a post to cross-check. The rule this replaced did a get()
    // on the author's user doc for EVERY post created — a billed read per post
    // to defend a copy that no longer exists.
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /feedPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.expiresAt is timestamp
                    // Nothing outlives the 24h window (+1h of clock slack).
                    && request.resource.data.expiresAt < request.time + duration.value(25, 'h');
      // Posts are immutable. Reaction counts live in the flames subcollection
      // precisely so reacting never needs write access to someone else's post.
      allow update: if false;
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.userId || isAdmin());

      // One doc per reactor, id = their uid: idempotent, no double-flame, and
      // the "liked by" list is just this collection's ids.
      match /flames/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // Abuse reports — any signed-in athlete files one, only triage reads them.
    // Mirrors movementFlags: append-only for clients, admin-only to drain.
    match /feedReports/{reportId} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.reporterId;
      allow read, update, delete: if isAdmin();
    }

  }
}
