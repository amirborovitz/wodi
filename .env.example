# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# Google Analytics (optional) — Firebase console → Project settings → your web app
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Show "Continue with Apple" — set to true only once the Apple provider in Firebase has its
# Services ID, team ID, key ID and private key (needs an Apple Developer account)
VITE_APPLE_SIGN_IN=false

# OpenAI API key — for local scripts ONLY (corpus, check-wod). No VITE_ prefix, so it can never
# reach the app bundle. The app calls the AI through the wodiModel Cloud Function, which reads its
# own copy: firebase functions:secrets:set OPENAI_API_KEY
OPENAI_API_KEY=your_openai_api_key

# Web push public key (it's public — safe in the bundle). Firebase console → Project settings →
# Cloud Messaging → Web Push certificates → Generate key pair. Without it Wodi never offers nudges.
VITE_FIREBASE_VAPID_KEY=your_web_push_public_key
