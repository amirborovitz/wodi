# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# Google Analytics (optional) — Firebase console → Project settings → your web app
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Show "Continue with Apple" — set to true only once the Apple provider in Firebase has its
# Services ID, team ID, key ID and private key (needs an Apple Developer account)
VITE_APPLE_SIGN_IN=false

# OpenAI API Key
VITE_OPENAI_API_KEY=your_openai_api_key
